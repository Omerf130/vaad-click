{
  "name": "vaad-click",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "verify:mongo": "node --env-file=.env.local scripts/verify-mongo-connection.mjs",
    "provision:lawyer-admin": "node --env-file=.env.local scripts/provision-lawyer-admin.mjs",
    "count:lawyer-admins": "node --env-file=.env.local scripts/count-lawyer-admins.mjs",
    "issue:lawyer-admin-setup-link": "node --env-file=.env.local scripts/issue-lawyer-admin-setup-link.mjs",
    "dev:sample-legal-document-pdf": "cross-env VAAD_DEV_SAMPLE_PDF=1 vitest run tests/building-legal-document-pdf.test.ts -t \"writes a dev sample PDF\""
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-hebrew": "^0.4.1",
    "argon2": "^0.45.1",
    "mongoose": "^9.11.2",
    "next": "16.4.3",
    "pdfmake": "^0.3.13",
    "rate-limiter-flexible": "^11.2.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
