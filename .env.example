# Application
# NODE_ENV=development

# Exact public browser origin for CSRF allowlist (production HTTPS only), e.g. https://your-project.vercel.app
# No trailing path — must match what users type in the address bar.
# ALLOWED_APP_ORIGIN=

# Cryptographic secret for session token HMAC and future auth (min 32 random bytes, base64 or hex)
AUTH_SECRET=

# MongoDB Atlas — server-only, never expose to the client
MONGODB_URI=

# Optional override; defaults: vaadclick_dev | vaadclick_test | vaadclick (by NODE_ENV)
MONGODB_DB_NAME=

# Debtor secure links (CP20+)
# DEBTOR_TOKEN_PEPPER=

# Cron / internal jobs (later)
# CRON_SECRET=

# Local-only lawyer admin provisioning recovery (never enable in production deployment)
# ALLOW_LAWYER_ADMIN_REPROVISION=false

# Temporary lawyer admin demo (production MFA exception) — see docs/LAWYER_DEMO_ACCESS.md
# Disabled by default. Requires both vars; LAWYER_DEMO_ACCESS_ENABLED must be exactly "true".
# LAWYER_DEMO_ACCESS_ENABLED=false
# LAWYER_DEMO_USER_ID=
